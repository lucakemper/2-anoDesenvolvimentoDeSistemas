Algoritmo "algoritimo de um retangulo"
Var
area : caractere
valor : inteiro
B : inteiro
H : inteiro
A : inteiro
// B =digite um numero
// H = digite um numeoro
// A = B * H

Inicio
escreval ("digie o valor de B : ")
leia (B)
escreval("")
escreval ("digite o valor de H : ")
leia (H)
 A <- B * H
 escreval("")
escreval ("area do retangulo", A)

Fimalgoritmo