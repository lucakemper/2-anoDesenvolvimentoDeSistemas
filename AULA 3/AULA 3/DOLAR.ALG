Algoritmo "dolar"
Var
valorreal : real
valordolar : real
resultado :  real
// valorreal : 1
// valordolar : 5,25
// Resultado : valorreal * valordolar

Inicio
escreval ("me fale um valor de real")
leia (valorreal)
escreval ("me fale o valor do dolar")
leia (valordolar)
escreval (" o valor convertido",valorreal * valordolar)

Fimalgoritmo