Algoritmo "semnome"

Var
contador : real

Inicio
enquanto ( verdadeiro ) faca
     escreval ("OI")
     interrompa
fimEnquanto

enquanto (contador < 10000) faca
 escreval (contador+1)
      se (contador = 100) entao
      escreval ("limite máximo!")
      interrompa
   fimSe
 contador <- contador + 0.10
fimenquanto


Fimalgoritmo